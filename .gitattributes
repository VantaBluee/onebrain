# Normalize to LF in the repo; check out LF everywhere (rustfmt and clippy
# expect LF, and cross-OS diffs must stay clean).
* text=auto eol=lf

# Windows-native scripts keep CRLF on checkout
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.gguf binary
*.png binary
*.ico binary
