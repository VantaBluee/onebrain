+socket_ptr socket_t::from_fd(long long raw_fd) {
+    sockfd_t fd = (sockfd_t) raw_fd;
+    if (!is_valid_fd(fd)) {
+        return nullptr;
+    }
+    // Best-effort: harmless when the fd is not a TCP socket (socketpair).
+    set_no_delay(fd);
+    return socket_ptr(new socket_t(std::make_unique<impl>(fd)));
+}
