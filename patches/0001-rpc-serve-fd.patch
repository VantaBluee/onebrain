+    printf("  local cache    : %s\n", cache_dir ? cache_dir : "n/a");
+    printf("Devices:\n");
+    if (!rpc_init_backends(backends, n_threads, n_devices, devices)) {
+        for (auto backend : backends) {
+            ggml_backend_free(backend);
+        }
