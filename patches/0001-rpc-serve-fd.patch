+void ggml_backend_rpc_serve_fd(long long fd, const char * cache_dir,
+                               size_t n_threads, size_t n_devices, ggml_backend_dev_t * devices) {
+    if (n_devices == 0 || devices == nullptr) {
+        fprintf(stderr, "Invalid arguments to ggml_backend_rpc_serve_fd\n");
+        return;
