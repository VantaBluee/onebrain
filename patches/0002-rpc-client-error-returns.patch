-    uint8_t cmd_byte = cmd;
-    if (!sock->send_data(&cmd_byte, sizeof(cmd_byte))) {
-        return false;
-    }
-    if (!sock->send_data(&input_size, sizeof(input_size))) {
+    // onebrain: error-return semantics (patches/0002): fail fast on sockets
+    // that already saw a failure instead of writing into a torn stream.
+    if (ob_rpc_is_dead(sock)) {
         return false;
     }
-    if (!sock->send_data(input, input_size)) {
+    uint8_t cmd_byte = cmd;
+    if (!sock->send_data(&cmd_byte, sizeof(cmd_byte)) ||
+        !sock->send_data(&input_size, sizeof(input_size)) ||
+        !sock->send_data(input, input_size) ||
+        !sock->flush()) {
+        ob_rpc_mark_dead(sock); // onebrain: error-return semantics (patches/0002)
         return false;
     }
-    return sock->flush();
+    return true;
 }
 
