+// onebrain: error-return semantics (patches/0002): registry of client sockets
+// that have seen a transport failure. Keyed by raw pointer with the weak_ptr
+// kept for exact identity — a recycled allocation at the same address cannot
+// lock to the old control block, so stale entries are pruned on lookup.
+static std::mutex ob_rpc_dead_sockets_mutex;
+static std::unordered_map<socket_t *, std::weak_ptr<socket_t>> ob_rpc_dead_sockets;
+
+static void ob_rpc_mark_dead(const socket_ptr & sock) {
+    if (sock == nullptr) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(ob_rpc_dead_sockets_mutex);
+    ob_rpc_dead_sockets[sock.get()] = sock;
+}
+
+static bool ob_rpc_is_dead(const socket_ptr & sock) {
+    if (sock == nullptr) {
+        return true; // a socket that never connected behaves like a dead one
+    }
+    std::lock_guard<std::mutex> lock(ob_rpc_dead_sockets_mutex);
+    auto it = ob_rpc_dead_sockets.find(sock.get());
+    if (it == ob_rpc_dead_sockets.end()) {
+        return false;
+    }
+    if (it->second.lock() != sock) {
+        ob_rpc_dead_sockets.erase(it); // stale entry from a freed socket
+        return false;
+    }
+    return true;
+}
+
+// onebrain: error-return semantics (patches/0002): log the first client-side
+// transport failure loudly; later ones are debug noise (teardown of a dead
+// session hits several of these on every buffer free).
+static void ob_rpc_log_fail(const char * where) {
+    static std::atomic<bool> ob_rpc_fail_logged{false};
+    if (!ob_rpc_fail_logged.exchange(true)) {
+        GGML_LOG_ERROR("RPC client: transport failure in %s (remote server lost); "
+                       "returning errors instead of aborting\n", where);
+    } else {
+        LOG_DBG("[%s] RPC client transport failure\n", where);
+    }
+}
