     }
+    // The server is serial and in-order per connection: this command's
+    // response proves every command submitted before it (itself included)
+    // has fully executed — the implicit ack that drains the pending FIFO.
+    uint64_t fence = pending->submitted;
     uint64_t out_size;
     if (!sock->recv_data(&out_size, sizeof(out_size)) ||
         out_size != output_size ||
@@ -382,9 +479,69 @@ static bool send_rpc_cmd(socket_ptr sock, enum rpc_cmd cmd, const void * input,
         ob_rpc_mark_dead(sock);
         return false;
