+// onebrain: client-side async pipelining (patches/0003)
+//
+// The RPC protocol sends several commands with NO response on the wire
+// (GRAPH_COMPUTE, GRAPH_RECOMPUTE, SET_TENSOR, MEMSET_TENSOR): the client
+// returns as soon as the bytes are written, while the server executes them
+// later. The server processes commands strictly serially, in order, per
+// connection — so the response of ANY later response-bearing command on the
+// same socket proves that every command submitted before it has fully
+// executed. That in-order guarantee is the whole correctness argument:
+//
+//  - the "pending-ack FIFO" per socket degenerates to a pair of counters
+//    (`submitted`, `completed`): acks are implicit, and one response
+//    acknowledges every command before it at once;
+//  - "drain" = one response-bearing fence round trip (GET_DEVICE_MEMORY, an
+//    existing command with untouched semantics — NO wire-format change);
+//  - reads (GET_TENSOR / COPY_TENSOR) need no explicit fence: their own
+//    response cannot arrive before prior computes finished, so a get on a
+//    pipelined endpoint always observes completed data;
+//  - remote write-after-read hazards (the sched overwriting an input copy a
+//    previous graph may still be reading) are ordered by the socket itself:
+//    the overwrite is a later command on the same connection.
+//
+// This lets the backend advertise `caps.async = true, events = true`:
+// `graph_compute` submits without waiting, `synchronize` drains everything,
+// `event_record` snapshots the submitted count as a marker, and
+// `event_wait`/`event_synchronize` drain to that marker (conservatively to
+// "now" when a fence is needed — a fence cannot wait for less than the whole
+// queue, and the marker check keeps fences amortized across the scheduler's
+// rotating pipeline copies). llama.cpp's own `pipeline_parallel` gate then
+// passes for multi-device RPC loads, overlapping per-ubatch prefill work
+// across nodes with zero server/protocol changes.
+//
+// Failure composition with patches/0002: a fence that fails marks the socket
+// dead exactly like any other round trip; the draining call surfaces the
+// error where its signature allows (graph_compute -> GGML_STATUS_FAILED,
+// cpy -> false), and void paths (synchronize/event_wait) log loudly and let
+// the next status-returning command on the dead socket fail fast.
+// onebrain: patches/0003: one pipelined fence whose response is still
+// unread — see ob_rpc_pending::tickets.
+struct ob_rpc_ticket {
+    uint64_t marker;       // command count proven executed once popped
+    uint64_t marker_bytes; // wire bytes proven executed once popped
+};
+
+struct ob_rpc_pending {
+    // Serializes whole transactions (send, or send+recv) on one socket, so a
+    // cross-thread event wait can never interleave bytes into another
+    // thread's exchange. Recursive because the response-bearing overload of
+    // send_rpc_cmd nests the fire-and-forget one.
+    std::recursive_mutex mtx;
+    // Count of commands written to the socket (with or without a response).
+    uint64_t submitted = 0;
+    // Highest `submitted` value proven executed by a later response.
+    uint64_t completed = 0;
+    // Same ledger in wire bytes: the in-flight window (`bytes_submitted -
+    // bytes_completed`) is what the flow-control cap below bounds.
+    uint64_t bytes_submitted = 0;
+    uint64_t bytes_completed = 0;
+    // Largest single command in the CURRENT burst; feeds the adaptive cap.
+    // Reset whenever the ledger fully drains, so request-response-paced
+    // phases (model load, whose multi-megabyte weight SETs would otherwise
+    // inflate the cap for the whole session) never leak their sizes into
+    // the pipelined phase — the cap always reflects the traffic actually
+    // in flight.
+    uint64_t largest_cmd = 0;
+    // Pipelined fences ("ack tickets"): positions whose fence REQUEST is
+    // already on the wire but whose response has not been read yet. The
+    // server answers a response-bearing command only after executing
+    // everything queued before it, so each deferred response, once read,
+    // proves execution up to its recorded position — without waiting for
+    // anything submitted after it. Responses arrive strictly in request
+    // order (the server is serial per connection), so this is a FIFO, and
+    // every response-bearing exchange must pop ALL outstanding tickets
+    // before reading its own response.
+    std::deque<ob_rpc_ticket> tickets;
+};
+
+// onebrain: patches/0003: client-side flow control. Unbounded pipelining is
+// actively harmful on real transports: a client that bursts several
+// ubatches of fire-and-forget SET_TENSOR/GRAPH_COMPUTE bytes while the
+// (serial) server is busy computing keeps the path at sustained line rate
+// with a multi-megabyte unread backlog. Measured on the CI netem leg
+// (1 Gbit / 0.5 ms namespaces, RPC bridged over a QUIC tunnel), the
+// failure mode is RECEIVER-side: the worker's kernel UDP receive buffer
+// (stock net.core.rmem_max = 212992 B ≈ 1.7 ms of line rate) overflows
+// whenever the QUIC endpoint's receive processing falls behind arrival —
+// routine while the same host is computing a graph — and every overflow
+// episode is packet loss to the QUIC stack (`netstat -su` RcvbufErrors;
+// the tc qdisc itself dropped nothing). Loss recovery then collapses the
+// congestion window so hard that overlapped prefill measured 2.5x SLOWER
+// than the sequential baseline, bimodally, and even decode's tiny
+// messages crawled afterwards. The cap bounds the standing backlog — and
+// with it both the duration of sustained line-rate pressure and the
+// worst-case damage of any one loss episode — to about FOUR ubatches:
+// the scheduler's own rotation depth (measured within a few percent of
+// uncapped on a healthy path), so a stalled receiver is exposed to a
+// bounded burst rather than an unbounded train. Enforcement is one ticket
+// pop per over-cap send — the ticket frees a whole earlier ubatch — and a
+// command larger than the whole cap always passes once the queue is empty
+// (no deadlock). `OB_RPC_INFLIGHT_CAP` overrides the byte floor for
+// experiments; 0 disables the cap.
+static const uint64_t OB_RPC_INFLIGHT_FLOOR = 4ull * 1024 * 1024;
+
+static uint64_t ob_rpc_inflight_cap(const ob_rpc_pending & pending) {
+    static const uint64_t env_cap = [] {
+        const char * v = std::getenv("OB_RPC_INFLIGHT_CAP");
+        return v ? (uint64_t) strtoull(v, nullptr, 10) : OB_RPC_INFLIGHT_FLOOR;
+    }();
+    static const bool disabled = [] {
+        const char * v = std::getenv("OB_RPC_INFLIGHT_CAP");
+        return v && strtoull(v, nullptr, 10) == 0;
+    }();
+    if (disabled) {
+        return UINT64_MAX;
+    }
+    // At least two full UBATCHES of traffic must fit, or the pipeline
+    // degenerates to lock-step (the streamed ubatch could never sit behind
+    // the computing one); FOUR matches the scheduler's own rotation depth
+    // (GGML_SCHED_MAX_COPIES), which its per-slot event waits already
+    // enforce — measured on the 1 Gbit netem leg, depth 4 tracks the
+    // uncapped pipeline within a few percent while depth 2 leaves ~15% on
+    // the table. The cap therefore normally shadows the scheduler's own
+    // throttle and exists to bound workloads whose submissions do NOT pass
+    // through rotating-slot waits (bulk async copies, future callers) and
+    // any pathological over-deep train. An ubatch is one dominant transfer
+    // (the largest command — the boundary/input activation SET) plus
+    // secondary commands (attention mask, serialized graph, fences) that
+    // are a fraction of it; half-the-largest-again plus fixed slack covers
+    // them with room for the mask growing across a long prompt.
+    const uint64_t four_ubatches = 4 * pending.largest_cmd + pending.largest_cmd / 2 + 1024 * 1024;
+    return env_cap > four_ubatches ? env_cap : four_ubatches;
+}
+
+static std::mutex ob_rpc_pending_map_mutex;
+static std::unordered_map<socket_t *, std::pair<std::weak_ptr<socket_t>, std::shared_ptr<ob_rpc_pending>>> ob_rpc_pending_map;
+
+// Per-socket pending ledger. Keyed like the dead-socket registry: raw
+// pointer for lookup, weak_ptr for exact identity, so a recycled allocation
+// at the same address gets a fresh ledger (the stale entry is replaced).
+static std::shared_ptr<ob_rpc_pending> ob_rpc_pending_for(const socket_ptr & sock) {
+    if (sock == nullptr) {
+        return nullptr;
+    }
+    std::lock_guard<std::mutex> lock(ob_rpc_pending_map_mutex);
+    auto it = ob_rpc_pending_map.find(sock.get());
+    if (it != ob_rpc_pending_map.end() && it->second.first.lock() == sock) {
+        return it->second.second;
+    }
+    auto state = std::make_shared<ob_rpc_pending>();
+    ob_rpc_pending_map[sock.get()] = {sock, state};
+    return state;
+}
+
+// onebrain: patches/0003: read one outstanding pipelined-fence response and
+// advance the ledger to its marker. Caller holds `pending.mtx` and
+// guarantees `!pending.tickets.empty()`. The response bytes are the fence
+// command's own (rpc_msg_get_device_memory_rsp); a short or malformed read
+// desyncs the stream exactly like any other failed response, so the socket
+// is marked dead (patches/0002) and the caller fails fast from then on.
+static bool ob_rpc_ticket_pop(const socket_ptr & sock, ob_rpc_pending & pending) {
+    ob_rpc_ticket ticket = pending.tickets.front();
+    pending.tickets.pop_front();
+    uint64_t out_size;
+    rpc_msg_get_device_memory_rsp response;
+    if (!sock->recv_data(&out_size, sizeof(out_size)) ||
+        out_size != sizeof(response) ||
+        !sock->recv_data(&response, sizeof(response))) {
+        ob_rpc_mark_dead(sock);
+        return false;
+    }
+    if (ticket.marker > pending.completed) {
+        pending.completed = ticket.marker;
+    }
+    if (ticket.marker_bytes > pending.bytes_completed) {
+        pending.bytes_completed = ticket.marker_bytes;
+    }
+    if (pending.completed == pending.submitted) {
+        pending.largest_cmd = 0; // fully drained: next burst relearns its size
+    }
+    return true;
+}
