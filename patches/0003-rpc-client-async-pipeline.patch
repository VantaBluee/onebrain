+// onebrain: client-side async pipelining (patches/0003): block until the
+// server has executed at least the first `target` submitted commands on this
+// socket. When the ledger cannot prove that already happened, one
+// response-bearing fence round trip (GET_DEVICE_MEMORY — an existing command,
+// unchanged wire semantics) does: the server answers it only after finishing
+// everything queued before it. A fence necessarily waits for the whole queue
+// (there are no per-command acks to wait on), which over-synchronizes past
+// `target`; the completed-marker check keeps that amortized. A fence failure
+// marks the socket dead (patches/0002) and logs loudly; the caller's
+// signature decides where the error return surfaces.
+static void ob_rpc_drain_to(const socket_ptr & sock, uint32_t device, uint64_t target) {
+    auto pending = ob_rpc_pending_for(sock);
+    if (pending == nullptr) {
+        return; // never-connected socket: nothing was ever submitted
+    }
+    std::lock_guard<std::recursive_mutex> lock(pending->mtx);
+    if (pending->completed >= target) {
+        return;
+    }
+    // Pipelined fences first: each outstanding ticket blocks only until the
+    // server has executed past ITS marker — draining to an old event marker
+    // through tickets does not wait for work submitted after it, which is
+    // what keeps a deep ubatch train actually overlapped.
+    while (pending->completed < target && !pending->tickets.empty()) {
+        if (!ob_rpc_ticket_pop(sock, *pending)) {
+            ob_rpc_log_fail(__func__);
+            return;
+        }
+    }
+    if (pending->completed >= target) {
+        return;
+    }
+    rpc_msg_get_device_memory_req request = {device};
+    rpc_msg_get_device_memory_rsp response;
+    if (!send_rpc_cmd(sock, RPC_CMD_GET_DEVICE_MEMORY, &request, sizeof(request), &response, sizeof(response))) {
+        ob_rpc_log_fail(__func__);
+    }
+}
+
+// onebrain: patches/0003: pipelined fence — put the fence REQUEST on the
+// wire now and defer reading its response (the "ack ticket"). One existing
+// response-bearing command (GET_DEVICE_MEMORY, unchanged wire semantics)
+// per marker turns a later drain into a positional wait: the server answers
+// it only after executing everything queued before it and keeps processing
+// afterwards, so waiting on the ticket does not stall work submitted after
+// the marker. The 16-byte response sits in the socket buffer until popped.
+// Called at event_record time, so each recorded marker costs one tiny
+// round trip amortized across the pipeline instead of a full-queue fence
+// at wait time.
+static void ob_rpc_fence_begin(const socket_ptr & sock, uint32_t device) {
+    auto pending = ob_rpc_pending_for(sock);
+    if (pending == nullptr) {
+        return;
+    }
+    std::lock_guard<std::recursive_mutex> lock(pending->mtx);
