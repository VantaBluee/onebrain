 static void ggml_backend_rpc_synchronize(ggml_backend_t backend) {
+    // onebrain: client-side async pipelining (patches/0003): drain all
+    // pending (unacked) commands on this backend's socket. Cheap when the
+    // ledger already proves completion (a response-bearing command ran after
+    // the last submission); one fence round trip otherwise. On a dead socket
+    // this fails fast per patches/0002 — the error surfaces on the next
+    // status-returning call.
+    ggml_backend_rpc_context * rpc_ctx = (ggml_backend_rpc_context *)backend->context;
+    auto sock = get_socket(rpc_ctx->endpoint);
+    if (sock == nullptr) {
+        return;
+    }
+    ob_rpc_drain_all(sock, rpc_ctx->device);
+}
+
+// onebrain: client-side async pipelining (patches/0003): async tensor entry
+// points. "Async" set is natural: SET_TENSOR has no response, and the data is
+// serialized into the request before the call returns, so the caller's
+// buffer is immediately reusable. A get MUST observe all pending computes on
+// the endpoint first — GET_TENSOR is response-bearing and the server is
+// serial in-order per connection, so its reply cannot arrive before every
+// previously submitted command executed: the drain is implicit in reading
+// the response (and the ledger advances inside send_rpc_cmd).
+static void ggml_backend_rpc_set_tensor_async(ggml_backend_t backend, ggml_tensor * tensor, const void * data, size_t offset, size_t size) {
+    GGML_ASSERT(tensor->buffer != nullptr && ggml_backend_buffer_is_rpc(tensor->buffer) && "tensor is not on an RPC buffer");
+    ggml_backend_rpc_buffer_set_tensor(tensor->buffer, tensor, data, offset, size);
+    GGML_UNUSED(backend);
+}
+
+static void ggml_backend_rpc_get_tensor_async(ggml_backend_t backend, const ggml_tensor * tensor, void * data, size_t offset, size_t size) {
+    GGML_ASSERT(tensor->buffer != nullptr && ggml_backend_buffer_is_rpc(tensor->buffer) && "tensor is not on an RPC buffer");
+    ggml_backend_rpc_buffer_get_tensor(tensor->buffer, tensor, data, offset, size);
+    GGML_UNUSED(backend);
+}
+
+// onebrain: patches/0003: pipelined copy INTO this RPC backend. The
+// profitable case is a host-resident source (the scheduler's split-boundary
+// input copy): it becomes one fire-and-forget SET_TENSOR that queues behind
+// the remote's in-flight graphs instead of stalling the host. Host data is
+// complete only when the producing backend is synchronous, so that case is
+// gated on a CPU source backend. Same-server copies reuse the remote-side
+// COPY_TENSOR (response-bearing, still correct); everything else returns
+// false and the scheduler falls back to its synchronized copy path.
+static bool ggml_backend_rpc_cpy_tensor_async(ggml_backend_t backend_src, ggml_backend_t backend_dst, const ggml_tensor * src, ggml_tensor * dst) {
+    if (dst->buffer == nullptr || !ggml_backend_buffer_is_rpc(dst->buffer)) {
+        return false;
+    }
+    if (src->buffer != nullptr && ggml_backend_buffer_is_rpc(src->buffer)) {
+        ggml_backend_rpc_buffer_context * src_ctx = (ggml_backend_rpc_buffer_context *)src->buffer->context;
+        ggml_backend_rpc_buffer_context * dst_ctx = (ggml_backend_rpc_buffer_context *)dst->buffer->context;
+        if (src_ctx->sock == dst_ctx->sock) {
+            return ggml_backend_rpc_buffer_cpy_tensor(dst->buffer, src, dst);
+        }
+        // Cross-server: the host must relay; let the sched's fallback do it.
+        return false;
+    }
+    if (src->buffer == nullptr || !ggml_backend_buffer_is_host(src->buffer)) {
+        return false;
+    }
+    // Only a synchronous producer guarantees host data is ready right now.
+    if (ggml_backend_dev_type(ggml_backend_get_device(backend_src)) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+        return false;
+    }
+    if (src->type != dst->type || !ggml_is_contiguous(src) || !ggml_is_contiguous(dst) ||
+        ggml_nbytes(src) != ggml_nbytes(dst)) {
+        return false;
+    }
+    ggml_backend_rpc_buffer_set_tensor(dst->buffer, dst, src->data, 0, ggml_nbytes(dst));
+    return true;
+    GGML_UNUSED(backend_dst);
+}
+
+// onebrain: patches/0003: events. An event is a marker into a socket's
+// pending-command FIFO: record snapshots the submitted count, wait/
+// synchronize drain that socket to the marker. Waits may run on another
+// backend's thread (the sched does cross-backend waits), hence the ledger's
+// transaction mutex and the event's own lock.
+struct ob_rpc_event_context {
+    std::mutex mtx;                 // guards the fields against record/wait races
+    std::weak_ptr<socket_t> sock;   // socket the marker was recorded on
+    uint32_t device   = 0;          // device id for the fence command
+    uint64_t marker   = 0;          // ledger position at record time
+    bool     recorded = false;
+};
+
+static void ggml_backend_rpc_event_record(ggml_backend_t backend, ggml_backend_event_t event) {
+    ggml_backend_rpc_context * rpc_ctx = (ggml_backend_rpc_context *)backend->context;
+    ob_rpc_event_context * ev = (ob_rpc_event_context *)event->context;
+    auto sock = get_socket(rpc_ctx->endpoint);
+    if (sock == nullptr) {
+        return; // never-connected endpoint: nothing to mark
+    }
+    uint64_t submitted = 0;
+    if (auto pending = ob_rpc_pending_for(sock)) {
+        std::lock_guard<std::recursive_mutex> lock(pending->mtx);
+        submitted = pending->submitted;
+    }
+    std::lock_guard<std::mutex> lock(ev->mtx);
+    ev->sock     = sock;
+    ev->device   = rpc_ctx->device;
+    ev->marker   = submitted;
+    ev->recorded = true;
+}
+
+static void ob_rpc_event_drain(ggml_backend_event_t event) {
+    ob_rpc_event_context * ev = (ob_rpc_event_context *)event->context;
+    socket_ptr sock;
+    uint32_t device;
+    uint64_t marker;
+    {
+        std::lock_guard<std::mutex> lock(ev->mtx);
+        if (!ev->recorded) {
+            return; // an event never recorded is complete by definition
+        }
+        sock   = ev->sock.lock();
+        device = ev->device;
+        marker = ev->marker;
+    }
+    if (sock == nullptr) {
+        return; // socket already freed: no work can still be in flight on it
+    }
+    ob_rpc_drain_to(sock, device, marker);
+}
+
+static void ggml_backend_rpc_event_wait(ggml_backend_t backend, ggml_backend_event_t event) {
+    // The client has no remote command queue to insert a dependency into, so
+    // "make `backend` wait for `event`" is implemented as the strongest
+    // correct form: block the calling thread until the event's socket has
+    // executed past the marker.
+    ob_rpc_event_drain(event);
