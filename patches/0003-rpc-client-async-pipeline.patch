 }
 
+// onebrain: client-side async pipelining (patches/0003): block until the
+// server has executed at least the first `target` submitted commands on this
+// socket. When the ledger cannot prove that already happened, one
+// response-bearing fence round trip (GET_DEVICE_MEMORY — an existing command,
+// unchanged wire semantics) does: the server answers it only after finishing
+// everything queued before it. A fence necessarily waits for the whole queue
+// (there are no per-command acks to wait on), which over-synchronizes past
+// `target`; the completed-marker check keeps that amortized. A fence failure
+// marks the socket dead (patches/0002) and logs loudly; the caller's
+// signature decides where the error return surfaces.
+static void ob_rpc_drain_to(const socket_ptr & sock, uint32_t device, uint64_t target) {
+    auto pending = ob_rpc_pending_for(sock);
+    if (pending == nullptr) {
+        return; // never-connected socket: nothing was ever submitted
+    }
+    std::lock_guard<std::recursive_mutex> lock(pending->mtx);
+    if (pending->completed >= target) {
+        return;
+    }
+    rpc_msg_get_device_memory_req request = {device};
+    rpc_msg_get_device_memory_rsp response;
+    if (!send_rpc_cmd(sock, RPC_CMD_GET_DEVICE_MEMORY, &request, sizeof(request), &response, sizeof(response))) {
+        ob_rpc_log_fail(__func__);
+    }
+}
+
+// onebrain: patches/0003: drain everything currently submitted on `sock`.
+static void ob_rpc_drain_all(const socket_ptr & sock, uint32_t device) {
+    auto pending = ob_rpc_pending_for(sock);
+    if (pending == nullptr) {
+        return;
+    }
+    uint64_t submitted;
+    {
+        std::lock_guard<std::recursive_mutex> lock(pending->mtx);
+        submitted = pending->submitted;
+    }
+    ob_rpc_drain_to(sock, device, submitted);
+}
+
+// onebrain: patches/0003: process-wide switch for the async/events capability
+// ADVERTISEMENT (default on) — the hook behind OneBrain's
+// `[perf] prefill_overlap` config knob (docs/perf.md §3). Disabled, get_props
+// reports async=false/events=false, llama.cpp's pipeline_parallel gate fails,
+// and schedulers created afterwards run without parallel copies: the
+// constructed M3 baseline for benches and the sim proof. Only the caps are
+// gated; the pending ledger, drains, and async entry points stay active (they
+// are correct either way — the server is serial in-order per connection), so
+// a context created while enabled keeps working if the flag flips under it.
+// llama caches the gate result per context (cparams.pipeline_parallel), so a
+// flip affects the NEXT context created, never a live one.
+static std::atomic<bool> ob_rpc_pipeline_enabled{true};
+
+void ggml_backend_rpc_pipeline_enable(bool enable) {
+    ob_rpc_pipeline_enabled.store(enable, std::memory_order_relaxed);
+}
